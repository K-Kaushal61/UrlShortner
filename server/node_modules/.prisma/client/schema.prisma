generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Yeh nayi line add karni hai
}

model Url {
  id        Int      @id @default(autoincrement())
  shortCode String   @unique
  longUrl   String
  createdAt DateTime @default(now())
}
